 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- #BANNER_ART: photographic depth-of-field asset; live text stays crisp.
       Only the header changes. Existing graphite/silver/blue palette is retained. -->
  <Border CornerRadius="14" BorderBrush="#353B42" BorderThickness="1" Margin="0,0,0,14" Background="#0D1013">
   <Grid Height="112" ClipToBounds="True">
    <Image Source="Assets/meca-gear-banner-20261105.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
    <Rectangle IsHitTestVisible="False">
     <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#F20D1013" Offset="0"/><GradientStop Color="#D90D1013" Offset="0.32"/>
      <GradientStop Color="#400D1013" Offset="0.64"/><GradientStop Color="#100D1013" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <Rectangle IsHitTestVisible="False">
     <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#000D1013" Offset="0.55"/><GradientStop Color="#C00D1013" Offset="1"/>
     </LinearGradientBrush></Rectangle.Fill>
    </Rectangle>
    <Grid Margin="24,10">
     <Border Background="#D9252A30" BorderBrush="#4A515A" BorderThickness="1" CornerRadius="16" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
      <TextBlock Text="WINDOWS CALIBRATION" FontSize="10" FontWeight="SemiBold" Foreground="#CDD3D9"/>
     </Border>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
      <TextBlock Text="MECA" FontSize="36" FontWeight="Black" FontFamily="Segoe UI" LineHeight="39" LineStackingStrategy="BlockLineHeight">
       <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF"/><GradientStop Color="#CDD3D9" Offset="0.6"/><GradientStop Color="#F3F5F7" Offset="1"/>
       </LinearGradientBrush></TextBlock.Foreground>
      </TextBlock>
      <TextBlock Text="Calibration Wizard" FontSize="20" FontWeight="SemiBold" Foreground="#F3F5F7" Margin="0,0,0,6"/>
      <TextBlock Text="IDENTIFY  /  SET MAXIMUMS  /  TEST" FontSize="10" Foreground="{StaticResource DimBrush}"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="#353B42" BorderThickness="1" CornerRadius="14" Padding="16">
   <StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="12,0,0,0"/>
     <ComboBox x:Name="DeviceCombo" Foreground="#152027" VerticalContentAlignment="Center" SelectionChanged="DeviceCombo_SelectionChanged" AutomationProperties.Name="Pedal controller">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#152027"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </DockPanel>
    <CheckBox x:Name="ClutchCheck" Content="Clutch installed (optional)" Checked="ClutchCheck_Changed" Unchecked="ClutchCheck_Changed" Foreground="{StaticResource LabelBrush}" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,8">
   <StackPanel>
    <TextBlock x:Name="StageText" Text="1 / 3 - IDENTIFY ALL PEDALS" HorizontalAlignment="Center" Foreground="{StaticResource DimBrush}" FontSize="12" Margin="0,0,0,8"/>
    <TextBlock x:Name="PhaseTitle" Text="Set up your pedals" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
    <TextBlock x:Name="InstructionText" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="#C8DDF3" Margin="0,8,0,8"/>
    <ItemsControl x:Name="Gauges" ItemTemplate="{StaticResource PedalGauge}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>

   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3">
    <StackPanel x:Name="BrakeAdjustmentPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0">
     <TextBlock x:Name="BrakeScaleText" TextAlignment="Center" Margin="0,0,0,8"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Name="LighterButton" Content="- Lighter brake" Tag="-1" Click="AdjustBrake_Click" Margin="0,0,12,0"/>
      <Button x:Name="HeavierButton" Content="+ Heavier brake" Tag="1" Click="AdjustBrake_Click"/>
     </StackPanel>
    </StackPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
   <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
    <Button x:Name="SaveButton" Content="Apply to Windows + save" Click="SaveSettings_Click" ToolTip="Review and apply Windows calibration; automatically back up previous values first." IsEnabled="False" Margin="0,0,10,0"/>
    <Button x:Name="BackupButton" Content="Back up Windows settings" Click="BackupSettings_Click" ToolTip="Read and back up the current Windows calibration, not unsaved preview adjustments." IsEnabled="False" Margin="0,0,10,0"/>
   <Button x:Name="RestoreButton" Content="Restore Windows backup" ToolTip="Choose a Windows calibration backup. Older preview reports cannot restore Windows settings." Click="RestoreSettings_Click" IsEnabled="False" Margin="0,0,10,0"/>
   <Button x:Name="StartButton" Content="Start setup" Click="Start_Click" Background="{StaticResource AccentBrush}" Foreground="White" HorizontalAlignment="Center" MinWidth="180"/>
   </WrapPanel>
   <TextBlock Text="Raw pedal setup. Windows calibration changes only after you confirm Apply. No firmware or driver changes." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,14,0,0"/>
  </StackPanel>
 </Grid>
</Window>
